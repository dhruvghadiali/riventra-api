{
  "name": "riventra-api",
  "version": "1.0.0",
  "private": true,
  "description": "Secure Node.js, Express, and MongoDB API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check src/app.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "mongoose": "^9.11.2",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.0"
  }
}
