NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/sit?retryWrites=true&w=majority
# Comma-separated browser origins. Leave empty for non-browser clients in development.
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
JWT_SECRET=<at-least-32-random-characters>
JWT_EXPIRES_IN=8h
SUPER_ADMIN_SIGNUP_KEY=<separate-random-bootstrap-secret>
SCANNER_BASE_URL=http://localhost:3000/scan
